# Copy to .env and adjust. All variables are optional.
FFML_DATA_DIR=./data
FFML_ARTIFACTS_DIR=./artifacts
FFML_LOG_LEVEL=INFO
# Never set this in a shared environment; it unlocks the 2025 holdout season.
# FFML_HOLDOUT_UNLOCK=false

# API
API_DATABASE_URL=sqlite:///./api.db
API_SECRET_KEY=change-me
API_CORS_ORIGINS=http://localhost:3000

# Alerts (Phase 5)
ALERT_WEBHOOK_URL=
