# Copy to .env and adjust. All variables are optional.
FFML_DATA_DIR=./data
FFML_ARTIFACTS_DIR=./artifacts
FFML_LOG_LEVEL=INFO
# Never set this in a shared environment; it unlocks the 2025 holdout season.
# FFML_HOLDOUT_UNLOCK=false

# API (docs/API.md section 2). production is the default and keeps projection
# routes off until a model passes its pre-registered test (D-099).
# FFML_APP_ENV=production
# FFML_DATABASE_URL=sqlite:///./data/app.db
# FFML_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# FFML_DOCS_ENABLED=false
# FFML_BODY_MAX_BYTES=262144
# FFML_RATE_LIMIT_ENABLED=true
# FFML_TRUSTED_PROXIES=[]

# Alerts (Phase 5): scripts/alert.py posts here (Slack, Discord, ntfy or generic JSON).
FFML_ALERT_WEBHOOK=
# ALERT_WEBHOOK_URL is still read as an alias of FFML_ALERT_WEBHOOK.
# ALERT_WEBHOOK_URL=
# Set to 1 only to re-pin the tracked schema file on purpose (see docs/RUNBOOK.md).
# FFML_UPDATE_SCHEMA_PIN=0
