# API image (FastAPI + uvicorn). Built and verified in CI only (no Docker locally, D-004).
# Reproducible build (QA-F09): the base image is pinned by digest (python:3.11-slim as
# published on 2026-11-05), dependencies come from the audited requirements.lock.txt, and
# the package itself is installed without resolving anything.
FROM python:3.11-slim@sha256:db20d8506e2f15b6db39b40b6015ca46bae855dec6dd326d462cfe79ae972893

ENV PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    FFML_APP_ENV=production

WORKDIR /app
COPY requirements.lock.txt ./
# pip and setuptools are not in the lock; the versions the base image ships carry
# advisories, so both are pinned here at their fixed releases (image audit, QA-4.2)
RUN pip install --no-cache-dir "pip==26.2" "setuptools==84.1.0" \
    && pip install --no-cache-dir -r requirements.lock.txt \
    && useradd --create-home --uid 10001 ffml
COPY pyproject.toml README.md ./
COPY ffml ./ffml
COPY api ./api
RUN pip install --no-cache-dir --no-deps .
USER ffml

# data/ and artifacts/ are mounted from the host (see docker-compose.yml)
ENV FFML_DATA_DIR=/app/data FFML_ARTIFACTS_DIR=/app/artifacts FFML_REPORTS_DIR=/app/reports
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/meta/health').status == 200 else 1)"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
